{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:native": "vite build --mode native",
    "native:sync": "npm run build:native && cap sync",
    "native:android": "cap open android",
    "native:ios": "cap open ios",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:pwa": "playwright test",
    "test:live": "node scripts/run-live-checks.mjs",
    "test:live-config": "node --test scripts/live-checks-contract.check.mjs",
    "test:licensed-art": "node --test scripts/stage-licensed-art.check.mjs scripts/stage-avatar-art.check.mjs scripts/shared-assets.check.mjs scripts/build-hosted-web.check.mjs scripts/companion-supplementals.check.mjs e2e/elemental-evaluation-server.check.mjs",
    "test:native-config": "node --test scripts/native-build-config.check.mjs",
    "generate-pwa-icons": "pwa-assets-generator --preset minimal-2023 public/favicon.svg",
    "test:asset-config": "node --test scripts/asset-checks-contract.check.mjs",
    "test:assets": "node scripts/run-asset-checks.mjs",
    "assets:import": "node scripts/shared-assets.mjs import",
    "assets:verify": "node scripts/shared-assets.mjs verify",
    "predev": "npm run assets:verify",
    "prebuild": "npm run assets:verify",
    "prebuild:native": "npm run assets:verify",
    "prepreview": "npm run assets:verify",
    "postbuild": "node scripts/verify-built-shared-assets.mjs dist",
    "postbuild:native": "node scripts/verify-built-shared-assets.mjs dist-native"
  },
  "dependencies": {
    "@abby-assets/avatar-runtime": "file:vendor/abby-assets-avatar-runtime-1.3.0.tgz",
    "@abby-assets/contracts": "file:vendor/abby-assets-contracts-1.4.0.tgz",
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@react-three/fiber": "^9.8.1",
    "@sentry/react": "^10.48.0",
    "@testing-library/dom": "^10.4.1",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.7.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.14.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@abby-assets/release-tools": "file:vendor/abby-assets-release-tools-1.6.0.tgz",
    "@aws-sdk/client-s3": "^3.1149.0",
    "@capacitor/cli": "^8.5.3",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.64.0",
    "@sentry/vite-plugin": "^3.2.0",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vite-pwa/assets-generator": "^1.0.2",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.4",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^29.0.2",
    "msw": "^2.13.3",
    "tailwindcss": "^4.2.2",
    "vite": "^8.0.1",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.1.4",
    "yauzl": "3.4.0"
  }
}
